{
  "name": "diff2html-report",
  "displayName": "diff2html-report",
  "icon": "assets/icon.png",
  "description": "A Git diff report generator For VSCode.",
  "version": "0.6.1",
  "license": "MIT",
  "publisher": "Lead007",
  "engines": {
    "vscode": "^1.68.0"
  },
  "homepage": "https://github.com/Lead007/vscode-diff2html-report/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Lead007/vscode-diff2html-report/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lead007/vscode-diff2html-report"
  },
  "keywords": [
    "git",
    "diff",
    "report"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.showGitCommit"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%diff2html-report.configuration.title%",
      "properties": {
        "diff2html-report.defaultDiffOptions": {
          "type": "object",
          "default": {
            "-b": false,
            "-w": false,
            "-M": false,
            "-C": false,
            "--submodule": false
          },
          "markdownDescription": "%diff2html-report.configuration.defaultDiffOptions%"
        },
        "diff2html-report.filter": {
          "type": "array",
          "default": "",
          "description": "%diff2html-report.configuration.filter%"
        },
        "diff2html-report.encoding": {
          "type": "string",
          "default": "utf8",
          "markdownDescription": "%diff2html-report.configuration.encoding%"
        },
        "diff2html-report.maxGitDiffFileSize": {
          "type": "number",
          "default": 67108864,
          "description": "%diff2html-report.configuration.maxGitDiffFileSize%"
        },
        "diff2html-report.functionDiffLineThreshold": {
          "type": "integer",
          "minimum": 0,
          "default": 30,
          "description": "%diff2html-report.configuration.functionDiffLineThreshold%"
        },
        "diff2html-report.functionDiffChangePercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 30,
          "description": "%diff2html-report.configuration.functionDiffChangePercentage%"
        },
        "diff2html-report.functionDiffContextLines": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "%diff2html-report.configuration.functionDiffContextLines%"
        },
        "diff2html-report.functionDiffSymbolKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "File",
              "Module",
              "Namespace",
              "Package",
              "Class",
              "Method",
              "Property",
              "Field",
              "Constructor",
              "Enum",
              "Interface",
              "Function",
              "Variable",
              "Constant",
              "String",
              "Number",
              "Boolean",
              "Array",
              "Object",
              "Key",
              "Null",
              "EnumMember",
              "Struct",
              "Event",
              "Operator",
              "TypeParameter"
            ]
          },
          "default": [
            "Function",
            "Method",
            "Constructor",
            "Operator"
          ],
          "markdownDescription": "%diff2html-report.configuration.functionDiffSymbolKinds%"
        },
        "diff2html-report.drawLineCount": {
          "type": "boolean",
          "default": true,
          "description": "%diff2html-report.configuration.drawLineCount%"
        },
        "diff2html-report.defaultViewType": {
          "type": "string",
          "enum": [
            "side-by-side",
            "line-by-line"
          ],
          "default": "side-by-side",
          "description": "%diff2html-report.configuration.defaultViewType%"
        },
        "diff2html-report.useOnlineResources": {
          "type": "boolean",
          "default": false,
          "description": "%diff2html-report.configuration.useOnlineResources%"
        }
      }
    },
    "commands": [
      {
        "command": "diff2html-report.generateDiffReport",
        "title": "%diff2html-report.command.generateDiffReport%"
      },
      {
        "command": "diff2html-report.generateChangeItemReport",
        "title": "%diff2html-report.command.generateChangeItemReport%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "diff2html-report.generateDiffReport",
          "when": "scmProvider == git",
          "group": "inline"
        },
        {
          "command": "diff2html-report.generateChangeItemReport",
          "when": "scmProvider == git",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && esbuild out/**/*.js --bundle --outdir=dist --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:webview:debug": "vite build --mode development --config vite.webview.config.ts",
    "check:webview": "vue-tsc --noEmit -p tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "build": "npm run check:webview && npm run build:webview && npm run compile",
    "build:debug": "npm run check:webview && npm run build:webview:debug && npm run compile",
    "dev:webview": "vite --config vite.webview.config.ts",
    "watch:webview": "vite build --config vite.webview.config.ts --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "release": "vsce package"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.10",
    "@types/mustache": "^4.2.6",
    "@types/node": "22.x",
    "@types/vscode": "1.68.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "element-plus": "^2.11.4",
    "esbuild": "^0.27.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "unocss": "^66.11.0",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "diff2html": "^3.4.55",
    "mustache": "^4.2.0",
    "open": "^11.0.1",
    "vscode-nls-i18n": "^0.2.4",
    "vue": "^3.5.22"
  }
}
