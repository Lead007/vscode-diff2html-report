{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "unocss/vite"]
	},
	"include": ["webview-vue/src/**/*.ts", "webview-vue/src/**/*.vue"]
}
